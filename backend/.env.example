# ==========================================================
# ConfCircle Backend — Example Environment Variables
# Copy to .env and adjust for local development.
# NEVER commit the real .env file.
# ==========================================================

# ---- Docker Compose (infrastructure) ----
POSTGRES_USER=conficircle
POSTGRES_PASSWORD=conficircle_dev_password
POSTGRES_PORT=5435

REDIS_PORT=6378

RABBITMQ_PORT=56780
RABBITMQ_MANAGEMENT_PORT=15690
RABBITMQ_USER=conficircle
RABBITMQ_PASSWORD=conficircle_dev_password

# ---- Common ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API Gateway ----
API_GATEWAY_PORT=3000
API_GATEWAY_URL=http://localhost:3000
IDENTITY_SERVICE_URL=http://localhost:3001
CONTENT_SERVICE_URL=http://localhost:3002
ASSESSMENT_SERVICE_URL=http://localhost:3003
PROGRESS_SERVICE_URL=http://localhost:3004

# ---- Security ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# CORS origins allowed by the gateway (Flutter web / local web apps)
CORS_ORIGINS=http://localhost:5000

RABBITMQ_URL=amqp://conficircle:conficircle_dev_password@localhost:56780/conficircle
REDIS_URL=redis://localhost:6379

# ---- Per-service databases (local dev = one PG container, four logical DBs) ----
IDENTITY_DATABASE_URL=postgresql://conficircle:conficircle_dev_password@localhost:14332/identity_db?schema=public
CONTENT_DATABASE_URL=postgresql://conficircle:conficircle_dev_password@localhost:14332/content_db?schema=public
ASSESSMENT_DATABASE_URL=postgresql://conficircle:conficircle_dev_password@localhost:14332/assessment_db?schema=public
PROGRESS_DATABASE_URL=postgresql://conficircle:conficircle_dev_password@localhost:14332/progress_db?schema=public

# ---- Service ports ----
IDENTITY_SERVICE_PORT=3001
CONTENT_SERVICE_PORT=3002
ASSESSMENT_SERVICE_PORT=3003
PROGRESS_SERVICE_PORT=3004
