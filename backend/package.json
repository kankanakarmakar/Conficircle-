{
  "name": "@conficircle/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:gateway": "pnpm --filter @conficircle/api-gateway build",
    "build:identity": "pnpm --filter @conficircle/identity-service build",
    "build:content": "pnpm --filter @conficircle/content-service build",
    "build:assessment": "pnpm --filter @conficircle/assessment-service build",
    "build:progress": "pnpm --filter @conficircle/progress-service build",
    "start": "pnpm -r --parallel start",
    "test": "pnpm -r test",
    "prisma:validate": "pnpm -r --filter ./apps/* prisma:validate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.9",
    "dotenv-cli": "7.4.0",
    "jest": "29.7.0",
    "prisma": "6.2.1",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
