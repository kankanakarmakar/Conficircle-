# =====================================================================
# ConfCircle — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=confcircle
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=confcircle
POSTGRES_PORT=5432
DATABASE_URL=postgresql://confcircle:change_me_dev_password@localhost:5432/confcircle?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-long-random-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- CORS ---
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Guest Session ---
GUEST_TTL_SECONDS=3600
GUEST_QUICKTIP_QUOTA=3
GUEST_QUESTION_COUNT=3

# --- Video ---
VIDEO_COMPLETION_THRESHOLD=0.9
# Generate with: openssl rand -base64 32
VIDEO_URL_SIGN_SECRET=replace-with-video-sign-secret
VIDEO_URL_TTL_SECONDS=300

# --- Downloads ---
DOWNLOAD_URL_SIGN_SECRET=replace-with-download-sign-secret
DOWNLOAD_URL_TTL_SECONDS=300

# --- Notifications ---
EMAIL_PROVIDER=stub
WHATSAPP_PROVIDER=stub
# EMAIL_FROM=noreply@confcircle.app
# SENDGRID_API_KEY=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# --- Logging ---
LOG_LEVEL=debug

# --- BullMQ ---
# Uses REDIS_URL above

# --- API base URL (for Flutter client) ---
# API_BASE_URL=http://localhost:3000

