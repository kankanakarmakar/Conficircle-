  "info": {
    "title": "ConfCircle API",
    "description": "ConfCircle — Learning & Community App API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "guest-ref": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Guest-Ref"
      },
      "idempotency-key": {
        "type": "apiKey",
        "in": "header",
        "name": "Idempotency-Key"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "example": "Alex Morgan"
          },
          "guestRef": {
            "type": "string",
            "example": "guest-uuid-1234"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "type": "object"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "guestRef": {
            "type": "string",
            "example": "guest-uuid-1234"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "refresh-token-xyz"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateGuestSessionDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Client-generated temporary device or install identifier"
          }
        }
      },
      "GuestSessionResponseDto": {
        "type": "object",
        "properties": {
          "guestRef": {
            "type": "string",
            "description": "Opaque guest reference token"
          },
          "expiresAt": {
            "type": "number",
            "description": "Unix timestamp in ms when session expires"
          },
          "quotaRemaining": {
            "type": "number",
            "description": "Total quick tip quota granted for session"
          }
        },
        "required": [
          "guestRef",
          "expiresAt",
          "quotaRemaining"
        ]
      },
      "VideoProgressDto": {
        "type": "object",
        "properties": {
          "positionSec": {
            "type": "number",
            "example": 45,
            "description": "Current playback position in seconds"
          }
        },
        "required": [
          "positionSec"
        ]
      },
      "SaveAnswerDto": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "selectedOptionId": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "selectedOptionId"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "group",
              "public"
            ],
            "default": "group"
          }
        },
        "required": [
          "groupId",
          "content"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "notificationConsentEmail": {
            "type": "boolean"
          },
          "notificationConsentWhatsapp": {
            "type": "boolean"
          },
          "optOutEmail": {
            "type": "boolean"
          },
          "optOutWhatsapp": {
            "type": "boolean"
          }
        }
      }
    }
  }
}